@using X.PagedList
@using X.PagedList.Mvc.Core
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IPagedList<Anzuelo.Application.DTOs.MenuDTO>

@{
    ViewData["Title"] = Localizer["TituloPagina"];
}

<style>
    .menu-table-wrap {
        background: #fff;
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(10, 47, 90, .08);
    }

    .menu-table thead th {
        background-color: var(--anzuelo-primary);
        color: #fff;
        font-size: .76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        border: none;
        padding: .9rem 1.2rem;
    }

    .menu-table tbody tr {
        border-bottom: 1px solid #edf0f2;
        transition: background .15s;
    }

    .menu-table tbody tr:last-child {
        border-bottom: none;
    }

    .menu-table tbody tr:hover {
        background: #fff5ee;
    }

    .menu-table td {
        padding: .85rem 1.2rem;
        vertical-align: middle;
        border: none;
    }

    .descripcion-menu {
        max-width: 320px;
        white-space: normal;
    }

    .badge-activo,
    .badge-inactivo {
        display: inline-block;
        min-width: 75px;
        padding: .3rem .8rem;
        border-radius: 2rem;
        color: #fff;
        font-size: .75rem;
        font-weight: 700;
        text-align: center;
    }

    .badge-activo {
        background: var(--anzuelo-success);
    }

    .badge-inactivo {
        background: #6c757d;
    }

    .top-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: .75rem;
        margin-bottom: 1rem;
    }

    .btn-menu-principal {
        background: var(--anzuelo-accent);
        color: #fff;
        border: 2px solid var(--anzuelo-accent);
        padding: .55rem 1rem;
        border-radius: .4rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        transition: opacity .2s;
    }

    .btn-menu-principal:hover {
        opacity: .85;
        color: #fff;
    }

    .fecha-columna,
    .horario-columna {
        white-space: nowrap;
    }

    .pagination {
        margin-bottom: 0;
    }

    .pagination .page-link {
        color: var(--anzuelo-primary);
        border-color: #dee2e6;
        font-size: .85rem;
        padding: .35rem .75rem;
    }

    .pagination .page-item.active .page-link {
        background-color: var(--anzuelo-primary);
        border-color: var(--anzuelo-primary);
        color: #fff;
    }

    .pagination .page-link:hover {
        background-color: #fff5ee;
        color: var(--anzuelo-accent);
        border-color: var(--anzuelo-accent);
    }
</style>

<div class="page-hero">
    <div class="container">
        <h1><i class="bi bi-journal-text me-2"></i>@Localizer["EncabezadoPrincipal"]</h1>
        <p class="page-hero-sub">@Localizer["SubtituloPrincipal"]</p>
    </div>
</div>

<div class="container">

    <div class="top-actions">
        <a asp-controller="Menu"
           asp-action="Details"
           class="btn-menu-principal">
            <i class="bi bi-eye"></i>
            @Localizer["BtnVerMenu"]
        </a>
    </div>

    @if (TempData["MensajeMenu"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show mt-3"
             role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @Localizer["msjSinMenu"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox"
               style="font-size: 3rem; opacity: .4;">
            </i>
            <h5 class="mt-3"> @Localizer["SinMenu"]</h5>
        </div>
    }
    else
    {
        <div class="menu-table-wrap">
            <div class="table-responsive">
                <table class="table menu-table mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["ThMenu"]</th>
                            <th>@Localizer["ThDescripcion"]</th>
                            <th>@Localizer["ThDisponibilidad"]</th>
                            <th>@Localizer["ThHorario"]</th>
                            <th class="text-center">@Localizer["ThEstado"]</th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            bool estadoActivo =
                                item.IdEstadoMenu == 1;

                            <tr>

                                <td>

                                    <strong>
                                        @item.NombreMenu
                                    </strong>

                                </td>

                                <td class="descripcion-menu">
                                    @item.Descripcion
                                </td>

                                <td class="fecha-columna">

                                    @item.FechaInicio.ToString("dd/MM/yyyy")

                                    <span class="mx-1">
                                        -
                                    </span>

                                    @item.FechaFinal.ToString("dd/MM/yyyy")

                                </td>

                                <td class="horario-columna">

                                    @item.HoraInicio.ToString("hh:mm tt")

                                    <span class="mx-1">
                                        -
                                    </span>

                                    @item.HoraFinal.ToString("hh:mm tt")

                                </td>

                                <td class="text-center">
                                    @if (estadoActivo)
                                    {
                                        <span class="badge-activo">
                                            @item.NombreEstado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-inactivo">
                                            @item.NombreEstado
                                        </span>
                                    }
                                </td>
                            </tr>
                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <td colspan="5">

                                <div class="d-flex justify-content-end">

                                    @Html.PagedListPager(
                                        Model,
                                        page => Url.Action(
                                            "Index",
                                            "Menu",
                                            new
                                            {
                                                page
                                            }),
                                        new PagedListRenderOptions
                                        {
                                            Display =
                                                PagedListDisplayMode.Always,

                                            MaximumPageNumbersToDisplay =
                                                5,

                                            LiElementClasses =
                                                new[]
                                                {
                                                    "page-item"
                                                },

                                            PageClasses =
                                                new[]
                                                {
                                                    "page-link"
                                                }
                                        })

                                </div>

                            </td>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>
    }

</div>