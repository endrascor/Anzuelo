@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model IEnumerable<Anzuelo.Application.DTOs.PedidoDTO>
@{
    ViewData["Title"] = Localizer["TituloPagina"];
    var esCliente = User.IsInRole("Cliente");
}
<style>
    .pedido-table-wrap {
        background: #fff;
        border-radius: .5rem;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(10, 47, 90, .08);
    }

    .pedido-table thead th {
        background-color: var(--anzuelo-primary);
        color: #fff;
        font-size: .76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        border: none;
        padding: .9rem 1.2rem;
    }

    .pedido-table tbody tr {
        border-bottom: 1px solid #edf0f2;
        transition: background .15s;
    }

        .pedido-table tbody tr:last-child {
            border-bottom: none;
        }

        .pedido-table tbody tr:hover {
            background: #fff5ee;
        }

    .pedido-table td {
        padding: .85rem 1.2rem;
        vertical-align: middle;
        border: none;
    }

    .badge-estado {
        color: #fff;
        font-size: .8rem;
        font-weight: 700;
        padding: .3em .85em;
        border-radius: 2rem;
        display: inline-block;
    }

    .badge-estado-pendiente {
        background: #e67e22;
    }

    .badge-estado-proceso {
        background: var(--anzuelo-primary);
    }

    .badge-estado-completado {
        background: #28a745;
    }

    .badge-estado-cancelado {
        background: #dc3545;
    }

    .btn-ver-pedido {
        background: transparent;
        border: 2px solid var(--anzuelo-accent);
        color: var(--anzuelo-accent);
        font-size: .8rem;
        font-weight: 600;
        padding: .28rem .85rem;
        border-radius: .35rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        transition: background .2s, color .2s;
    }

        .btn-ver-pedido:hover {
            background: var(--anzuelo-accent);
            color: #fff;
        }

    .form-section {
        border: 1px solid #dee2e6;
        border-radius: .65rem;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        background: #fff;
    }

    .form-section-title {
        color: var(--anzuelo-primary);
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .btn-filtrar {
        background: var(--anzuelo-accent);
        border-color: var(--anzuelo-accent);
        color: #fff;
        font-weight: 600;
    }

        .btn-filtrar:hover {
            background: var(--anzuelo-primary);
            border-color: var(--anzuelo-primary);
            color: #fff;
        }
</style>

<div class="page-hero">
    <div class="container">
        <h1><i class="bi bi-clock-history me-2"></i>@Localizer["EncabezadoPrincipal"]</h1>
        <p class="page-hero-sub">@Localizer["SubtituloPrincipal"]</p>
    </div>
</div>

<div class="container">

    @if (!esCliente)
    {
        <section class="form-section">
            <div class="form-section-title"><i class="bi bi-funnel me-1"></i>@Localizer["SeccionFiltros"]</div>
            <form asp-action="Index" method="get" class="row align-items-end">
                <div class="col-md-4 mb-2">
                    <label class="form-label">@Localizer["LabelFiltroFecha"]</label>
                    <input type="date" name="fecha" class="form-control" value="@ViewBag.FechaFiltro" />
                </div>
                <div class="col-md-4 mb-2">
                    <label class="form-label">@Localizer["LabelFiltroEstado"]</label>
                    <select name="idEstadoPedido" class="form-select">
                        <option value="">@Localizer["OpcionTodosEstados"]</option>
                        @foreach (var estado in (IEnumerable<Anzuelo.Application.DTOs.EstadoPedidoDTO>)ViewBag.ListEstadoPedido)
                        {
                            <option value="@estado.IdEstadoPedido" selected="@(ViewBag.EstadoFiltro == estado.IdEstadoPedido)">
                                @estado.Descripcion
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4 mb-2">
                    <button type="submit" class="btn btn-filtrar w-100">
                        <i class="bi bi-search me-1"></i>@Localizer["BtnFiltrar"]
                    </button>
                </div>
            </form>
        </section>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-inbox" style="font-size:3rem;opacity:.4;"></i>
            <h5 class="mt-3">@Localizer["SinPedidos"]</h5>
        </div>
    }
    else
    {
        <div class="pedido-table-wrap">
            <table class="table pedido-table mb-0">
                <thead>
                    <tr>
                        <th>@Localizer["ThFecha"]</th>
                        @if (!esCliente)
                        {
                            <th>@Localizer["ThCliente"]</th>
                        }
                        <th>@Localizer["ThEntrega"]</th>
                        <th class="text-end">@Localizer["ThTotal"]</th>
                        <th class="text-center">@Localizer["ThEstado"]</th>
                        <th class="text-center">@Localizer["ThDetalle"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FechaPedido.ToString("dd/MM/yyyy HH:mm")</td>
                            @if (!esCliente)
                            {
                                <td>@item.NombreCliente</td>
                            }
                            <td>@item.NombreTipoEntrega</td>
                            <td class="text-end">₡@item.Total.ToString("N2")</td>
                            <td class="text-center">
                                <span class="badge-estado @ObtenerClaseEstado(item.NombreEstado)">
                                    @item.NombreEstado
                                </span>
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.IdPedido" class="btn-ver-pedido">
                                    @Localizer["BtnVerDetalle"]
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@functions {
    string ObtenerClaseEstado(string? nombreEstado)
    {
        if (string.IsNullOrEmpty(nombreEstado)) return "badge-estado-pendiente";

        var estado = nombreEstado.ToLower();

        if (estado.Contains("pendiente")) return "badge-estado-pendiente";
        if (estado.Contains("cancelad")) return "badge-estado-cancelado";
        if (estado.Contains("entregad") || estado.Contains("complet")) return "badge-estado-completado";

        return "badge-estado-proceso";
    }
}