@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Anzuelo.Application.DTOs.PedidoDTO
@{
    ViewData["Title"] = Localizer["TituloSeguimiento"];
}
<style>
    .seguimiento-card {
        border: none;
        border-radius: .65rem;
        box-shadow: 0 2px 12px rgba(10, 47, 90, .08);
        padding: 1.25rem;
        margin-bottom: 1.25rem;
        background: #fff;
    }

    .seguimiento-titulo-linea {
        font-weight: 700;
        color: var(--anzuelo-primary);
        margin-bottom: .75rem;
    }

    .seguimiento-subtitulo-producto {
        font-weight: 600;
        color: #6c757d;
        font-size: .85rem;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin: 1rem 0 .5rem;
    }

        .seguimiento-subtitulo-producto:first-of-type {
            margin-top: 0;
        }

    .progreso-bar-wrap {
        background: #edf0f2;
        border-radius: 2rem;
        height: 10px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .progreso-bar-fill {
        height: 100%;
        background: var(--anzuelo-accent);
    }

    .estacion-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .6rem .9rem;
        border-radius: .45rem;
        margin-bottom: .5rem;
    }

    .estacion-pendiente {
        background: #f8f9fa;
        color: #6c757d;
    }

    .estacion-proceso {
        background: #fff5ee;
        color: var(--anzuelo-accent);
        font-weight: 600;
    }

    .estacion-completado {
        background: #eaf7ec;
        color: #28a745;
        font-weight: 600;
    }
</style>
<div class="page-hero">
    <div class="container">
        <h1><i class="bi bi-truck me-2"></i>@Localizer["TituloSeguimiento"]</h1>
        <p class="page-hero-sub">@Localizer["SubtituloSeguimiento"] #@Model.IdPedido</p>
    </div>
</div>
<div class="container">
    @foreach (var linea in Model.Detalles)
    {
        var porcentaje = linea.TotalEstaciones == 0 ? 0 : (linea.EstacionesCompletadas * 100) / linea.TotalEstaciones;

        <div class="seguimiento-card">
            <div class="seguimiento-titulo-linea">@linea.Nombre</div>
            <div class="progreso-bar-wrap">
                <div class="progreso-bar-fill" style="width:@porcentaje%;"></div>
            </div>
            @foreach (var productoEstaciones in linea.ProductosEstaciones)
            {
                @if (linea.ProductosEstaciones.Count > 1)
                {
                    <div class="seguimiento-subtitulo-producto">@productoEstaciones.NombreProducto</div>
                }
                @foreach (var estacion in productoEstaciones.Estaciones)
                {
                    <div class="estacion-item estacion-@estacion.ClaseEstado">
                        <span><i class="bi bi-circle-fill me-2" style="font-size:.5rem;"></i>@estacion.NombreEstacion</span>
                        <span>@estacion.NombreEstadoPedidoEstacion</span>
                    </div>
                }
            }
        </div>
    }
</div>