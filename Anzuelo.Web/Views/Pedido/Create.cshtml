@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Anzuelo.Application.DTOs.PedidoDTO
@{
    ViewData["Title"] = Localizer["TituloPedido"];
    var esCliente = User.IsInRole("Cliente");
    var listaDirecciones = (IEnumerable<Anzuelo.Application.DTOs.DireccionDTO>)ViewBag.ListDirecciones;
    var hayDirecciones = listaDirecciones != null && listaDirecciones.Any();
}

<style>
    .create-card {
        border: none;
        border-radius: .75rem;
        box-shadow: 0 4px 18px rgba(10,47,90,.10);
        overflow: hidden;
    }

    .create-card-header {
        background: var(--anzuelo-primary);
        color: #fff;
        padding: 1.25rem 1.5rem;
    }

        .create-card-header h2 {
            margin: 0;
            font-weight: 700;
        }

    .form-section {
        border: 1px solid #dee2e6;
        border-radius: .65rem;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        background: #fff;
    }

    .form-section-title {
        color: var(--anzuelo-primary);
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .info-cliente-box {
        background: #f8f9fa;
        border: 1px solid #e5e8eb;
        border-radius: .55rem;
        padding: 1rem;
        margin-top: .75rem;
    }

    .btn-guardar-pedido {
        background: var(--anzuelo-accent);
        border-color: var(--anzuelo-accent);
        color: #fff;
        font-weight: 600;
    }

        .btn-guardar-pedido:hover {
            background: var(--anzuelo-primary);
            border-color: var(--anzuelo-primary);
            color: #fff;
        }

    .modal-pago-header {
        background: var(--anzuelo-primary);
        color: #fff;
    }

    .modal-pago-resumen {
        background: #fff5ee;
        border-radius: .5rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
    }

        .modal-pago-resumen .fila-total {
            display: flex;
            justify-content: space-between;
            padding: .2rem 0;
        }

        .modal-pago-resumen .fila-total-final {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--anzuelo-accent);
            border-top: 1px solid #e6c9ab;
            margin-top: .4rem;
            padding-top: .4rem;
        }
</style>

<div class="page-hero">
    <div class="container">
        <h1><i class="bi bi-receipt me-2"></i>@Localizer["TituloPedido"]</h1>
        <p class="page-hero-sub">@Localizer["SubtituloHero"]</p>
    </div>
</div>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card create-card">
                <div class="create-card-header">
                    <h2><i class="bi bi-cart-check me-2"></i>@Localizer["TituloNuevoPedido"]</h2>
                    <p class="mb-0 mt-1">@Localizer["SubtituloNuevoPedido"]</p>
                </div>
                <div class="card-body p-4">
                    <form id="formPedido">
                        @Html.AntiForgeryToken()

                        <section class="form-section">
                            <div class="form-section-title"><i class="bi bi-info-circle me-1"></i>@Localizer["SeccionInformacionGeneral"]</div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">@Localizer["LabelFecha"]</label>
                                    <input type="text" class="form-control" value="@DateTime.Now.ToString("dd/MM/yyyy")" disabled />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label">@Localizer["LabelEstado"]</label>
                                    <input type="text" class="form-control" value="@Localizer["ValorEstadoInicial"]" disabled />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="IdTipoEntrega" class="form-label">@Localizer["LabelMetodoEntrega"]</label>
                                    <select asp-for="IdTipoEntrega" class="form-select" id="selectTipoEntrega"
                                            asp-items="@(new SelectList(ViewBag.ListTipoEntrega, "IdTipoEntrega", "Descripcion"))">
                                        <option value="">@Localizer["OpcionSeleccione"]</option>
                                    </select>
                                </div>
                            </div>

                            @if (esCliente)
                            {
                                var clienteSesion = ViewBag.ClienteSesion as Anzuelo.Application.DTOs.UsuarioDTO;
                                <input type="hidden" asp-for="IdUsuarioCliente" value="@clienteSesion?.IdUsuario" />
                                <div class="info-cliente-box">
                                    <p class="mb-1"><strong>@Localizer["LabelClienteColon"]</strong> @clienteSesion?.Nombre @clienteSesion?.Apellido1</p>
                                    <p class="mb-0"><strong>@Localizer["LabelCedulaColon"]</strong> @clienteSesion?.Cedula</p>
                                </div>

                                <div class="row mt-3" id="seccionDireccion" style="display:none;">
                                    <div class="col-md-12" id="contenedorDireccion">
                                        @if (hayDirecciones)
                                        {
                                            <label class="form-label">@Localizer["LabelDireccionEntrega"]</label>
                                            <select asp-for="IdDireccion" name="IdDireccion" class="form-select">
                                                <option value="">@Localizer["OpcionSeleccioneDireccion"]</option>
                                                @foreach (var d in listaDirecciones)
                                                {
                                                    <option value="@d.IdDireccion">@d.Provincia, @d.Canton, @d.Distrito - @d.Detalle</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="info-cliente-box">
                                                <p class="mb-2"><strong>@Localizer["MsgNoDireccionesRegistradas"]</strong> @Localizer["MsgAgregueParaContinuar"]</p>
                                                <div class="row">
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@Localizer["LabelProvincia"]</label>
                                                        <input type="text" class="form-control form-control-sm" id="nuevaProvincia" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@Localizer["LabelCanton"]</label>
                                                        <input type="text" class="form-control form-control-sm" id="nuevoCanton" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@Localizer["LabelDistrito"]</label>
                                                        <input type="text" class="form-control form-control-sm" id="nuevoDistrito" />
                                                    </div>
                                                    <div class="col-md-6 mb-2">
                                                        <label class="form-label">@Localizer["LabelDetalleSenas"]</label>
                                                        <input type="text" class="form-control form-control-sm" id="nuevoDetalle" />
                                                    </div>
                                                </div>
                                                <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="btnGuardarDireccion">
                                                    <i class="bi bi-plus-lg me-1"></i>@Localizer["BtnGuardarDireccion"]
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row mt-3">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="IdUsuarioCliente" class="form-label">@Localizer["LabelClienteSelect"]</label>
                                        <select asp-for="IdUsuarioCliente" class="form-select" id="selectCliente">
                                            <option value="">@Localizer["OpcionSeleccioneCliente"]</option>
                                            @foreach (var c in (IEnumerable<Anzuelo.Application.DTOs.UsuarioDTO>)ViewBag.ListClientes)
                                            {
                                                <option value="@c.IdUsuario" data-cedula="@c.Cedula" data-email="@c.Email">
                                                    @c.Nombre @c.Apellido1
                                                </option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">@Localizer["LabelInfoCliente"]</label>
                                        <div class="info-cliente-box" id="infoClienteSeleccionado">
                                            <p class="mb-0 text-muted">@Localizer["MsgSeleccioneClienteInfo"]</p>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-3" id="seccionDireccion" style="display:none;">
                                    <div class="col-md-12" id="contenedorDireccion">
                                        <label class="form-label">@Localizer["LabelDireccionEntrega"]</label>
                                        <select name="IdDireccion" class="form-select">
                                            <option value="">@Localizer["OpcionPrimeroSeleccioneCliente"]</option>
                                        </select>
                                    </div>
                                </div>
                            }
                        </section>

                        <section class="form-section" id="seccionAgregar">
                            <div class="form-section-title"><i class="bi bi-plus-circle me-1"></i>@Localizer["SeccionAgregarProductoCombo"]</div>
                            <div class="row align-items-end">
                                <div class="col-md-5 mb-2">
                                    <label class="form-label">@Localizer["LabelProductoCombo"]</label>
                                    <select class="form-select" id="selectItem">
                                        <option value="">@Localizer["OpcionSeleccione"]</option>
                                        <optgroup label="@Localizer["OptgroupProductos"]">
                                            @foreach (var p in (IEnumerable<Anzuelo.Application.DTOs.ProductoDTO>)ViewBag.ListProductos)
                                            {
                                                <option value="P-@p.IdProducto">@p.Nombre - ₡@p.Precio.ToString("N2")</option>
                                            }
                                        </optgroup>
                                        <optgroup label="@Localizer["OptgroupCombos"]">
                                            @foreach (var c in (IEnumerable<Anzuelo.Application.DTOs.ComboDTO>)ViewBag.ListCombos)
                                            {
                                                <option value="C-@c.IdCombo">@c.Nombre - ₡@c.PrecioTotal.ToString("N2")</option>
                                            }
                                        </optgroup>
                                    </select>
                                </div>
                                <div class="col-md-2 mb-2">
                                    <label class="form-label">@Localizer["LabelCantidad"]</label>
                                    <input type="number" min="1" value="1" class="form-control" id="inputCantidadNueva" />
                                </div>
                                <div class="col-md-3 mb-2">
                                    <label class="form-label">@Localizer["LabelObservaciones"]</label>
                                    <input type="text" class="form-control" id="inputObservacionesNueva" placeholder="@Localizer["PlaceholderOpcional"]" />
                                </div>
                                <div class="col-md-2 mb-2">
                                    <button type="button" class="btn btn-outline-primary w-100" id="btnAgregarLinea">
                                        <i class="bi bi-plus-lg me-1"></i>@Localizer["BtnAgregar"]
                                    </button>
                                </div>
                            </div>
                        </section>

                        <section class="form-section" id="seccionDetalle">
                            <div class="form-section-title"><i class="bi bi-list-ul me-1"></i>@Localizer["SeccionDetallePedido"]</div>
                            <div id="contenedorDetallePedido">
                                @await Html.PartialAsync("_DetallePedido", (List<Anzuelo.Application.DTOs.DetallePedidoDTO>)ViewBag.CarritoActual)
                            </div>
                        </section>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>@Localizer["BtnCancelar"]</a>
                            <button type="button" class="btn btn-guardar-pedido" id="btnAbrirModalPago"><i class="bi bi-credit-card me-1"></i>@Localizer["BtnFinalizarPedido"]</button>
                        </div>

                        <div class="modal fade" id="modalPago" tabindex="-1" aria-labelledby="modalPagoLabel" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header modal-pago-header">
                                        <h5 class="modal-title" id="modalPagoLabel"><i class="bi bi-credit-card me-2"></i>@Localizer["TituloModalPago"]</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="modal-pago-resumen">
                                            <div class="fila-total">
                                                <span>@Localizer["LabelSubtotal"]</span>
                                                <span id="modalValorSubtotal">₡0.00</span>
                                            </div>
                                            <div class="fila-total">
                                                <span>@Localizer["LabelImpuesto"]</span>
                                                <span id="modalValorImpuesto">₡0.00</span>
                                            </div>
                                            <div class="fila-total" id="modalFilaCostoEnvio" style="display:none;">
                                                <span>@Localizer["LabelCostoEnvio"]</span>
                                                <span id="modalValorCostoEnvio">₡0.00</span>
                                            </div>
                                            <div class="fila-total fila-total-final">
                                                <span>@Localizer["LabelTotal"]</span>
                                                <span id="modalValorTotal">₡0.00</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label">@Localizer["SeccionMetodoPago"]</label>
                                            <select class="form-select" id="selectMetodoPago" name="Pago.IdMetodoPago">
                                                <option value="">@Localizer["OpcionSeleccione"]</option>
                                                @foreach (var m in (IEnumerable<Anzuelo.Application.DTOs.MetodoPagoDTO>)ViewBag.ListMetodoPago)
                                                {
                                                    <option value="@m.IdMetodoPago" data-descripcion="@m.Descripcion.ToLower()">@m.Descripcion</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3" id="campoMontoRecibido" style="display:none;">
                                            <label class="form-label">@Localizer["LabelMontoRecibido"]</label>
                                            <input type="number" step="0.01" class="form-control" name="Pago.MontoRecibido" id="inputMontoRecibido" />
                                        </div>
                                        <div class="mb-3" id="campoVuelto" style="display:none;">
                                            <label class="form-label">@Localizer["LabelVuelto"]</label>
                                            <input type="text" class="form-control" id="inputVuelto" disabled />
                                        </div>
                                        <div class="mb-3" id="campoTarjeta" style="display:none;">
                                            <label class="form-label">@Localizer["LabelUltimos4Tarjeta"]</label>
                                            <input type="text" maxlength="4" class="form-control" name="Pago.Ultimos4Tarjeta" id="inputUltimos4" />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["BtnCancelar"]</button>
                                        <button type="button" class="btn btn-guardar-pedido" id="btnConfirmarPago"><i class="bi bi-check-circle me-1"></i>@Localizer["BtnConfirmarPago"]</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const msgError = '@Localizer["MsgErrorTitulo"]';
        const msgErrorGenerico = '@Localizer["MsgErrorGenericoTitulo"]';
        const msgDebeSeleccionarProductoCombo = '@Localizer["MsgDebeSeleccionarProductoCombo"]';
        const msgCantidadMayorCero = '@Localizer["MsgCantidadMayorCero"]';
        const msgCamposDireccionObligatorios = '@Localizer["MsgCamposDireccionObligatorios"]';
        const msgDebeAgregarProductoComboPedido = '@Localizer["MsgDebeAgregarProductoComboPedido"]';
        const msgDebeSeleccionarMetodoPago = '@Localizer["MsgDebeSeleccionarMetodoPago"]';
        const msgDebeSeleccionarMetodoEntrega = '@Localizer["MsgDebeSeleccionarMetodoEntrega"]';
        const msgPedidoRegistrado = '@Localizer["MsgPedidoRegistrado"]';
        const msgSeleccioneClienteInfo = '@Localizer["MsgSeleccioneClienteInfo"]';
        const optPrimeroSeleccioneCliente = '@Localizer["OpcionPrimeroSeleccioneCliente"]';
        const labelDireccionEntrega = '@Localizer["LabelDireccionEntrega"]';
        const labelCedulaColon = '@Localizer["LabelCedulaColon"]';
        const labelEmailColon = '@Localizer["LabelEmailColon"]';
        const msgMontoRecibidoInsuficiente = '@Localizer["MsgMontoRecibidoInsuficiente"]';
        const msgDebeIndicarUltimos4 = '@Localizer["MsgDebeIndicarUltimos4"]';

        let modalPago;

        document.addEventListener('DOMContentLoaded', function () {
            modalPago = new bootstrap.Modal(document.getElementById('modalPago'));
            actualizarTotalInline();
        });

        function actualizarContadorGlobal() {
            if (typeof actualizarContadorCarrito === 'function') {
                actualizarContadorCarrito();
            }
        }

        function calcularTotales() {
            const tabla = document.getElementById('tablaCarrito');
            const subtotal = parseFloat(tabla?.dataset.subtotal) || 0;
            const impuesto = parseFloat(tabla?.dataset.impuesto) || 0;

            const tipoEntregaSelect = document.getElementById('selectTipoEntrega');
            const textoSeleccionado = tipoEntregaSelect.options[tipoEntregaSelect.selectedIndex]?.text?.toLowerCase() || '';
            const esDomicilio = textoSeleccionado.includes('domicilio');
            const costoEnvio = esDomicilio ? 1500 : 0;

            const total = subtotal + impuesto + costoEnvio;

            return { subtotal, impuesto, costoEnvio, esDomicilio, total };
        }

        function actualizarTotalInline() {
            const { costoEnvio, esDomicilio, total } = calcularTotales();

            const filaEnvio = document.getElementById('filaCostoEnvio');
            const valorEnvio = document.getElementById('valorCostoEnvio');
            const valorTotal = document.getElementById('valorTotalPedido');

            if (!filaEnvio || !valorEnvio || !valorTotal) return;

            if (esDomicilio) {
                filaEnvio.style.display = 'flex';
                valorEnvio.textContent = '₡' + costoEnvio.toFixed(2);
            } else {
                filaEnvio.style.display = 'none';
            }

            valorTotal.textContent = '₡' + total.toFixed(2);
            valorTotal.dataset.totalCrudo = total.toFixed(2);
        }

        function actualizarResumenModal() {
            const { subtotal, impuesto, costoEnvio, esDomicilio, total } = calcularTotales();

            document.getElementById('modalValorSubtotal').textContent = '₡' + subtotal.toFixed(2);
            document.getElementById('modalValorImpuesto').textContent = '₡' + impuesto.toFixed(2);

            const filaEnvio = document.getElementById('modalFilaCostoEnvio');
            if (esDomicilio) {
                filaEnvio.style.display = 'flex';
                document.getElementById('modalValorCostoEnvio').textContent = '₡' + costoEnvio.toFixed(2);
            } else {
                filaEnvio.style.display = 'none';
            }

            const valorTotal = document.getElementById('modalValorTotal');
            valorTotal.textContent = '₡' + total.toFixed(2);
            valorTotal.dataset.totalCrudo = total.toFixed(2);

            actualizarVuelto();
        }

        function actualizarVuelto() {
            const valorTotal = document.getElementById('modalValorTotal');
            const total = parseFloat(valorTotal?.dataset.totalCrudo) || 0;
            const montoInput = document.getElementById('inputMontoRecibido');
            const vueltoInput = document.getElementById('inputVuelto');

            if (montoInput && vueltoInput) {
                const monto = parseFloat(montoInput.value) || 0;
                const vuelto = monto - total;
                vueltoInput.value = '₡' + (vuelto >= 0 ? vuelto.toFixed(2) : '0.00');
            }
        }

        document.getElementById('selectTipoEntrega')?.addEventListener('change', function () {
            const seccionDireccion = document.getElementById('seccionDireccion');
            const texto = this.options[this.selectedIndex]?.text?.toLowerCase() || '';
            if (seccionDireccion) {
                seccionDireccion.style.display = texto.includes('domicilio') ? 'block' : 'none';
            }
            actualizarTotalInline();
        });

        document.getElementById('selectCliente')?.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            const contenedor = document.getElementById('infoClienteSeleccionado');
            if (this.value) {
                contenedor.innerHTML = `
                    <p class="mb-1"><strong>${labelCedulaColon}</strong> ${opt.dataset.cedula}</p>
                    <p class="mb-0"><strong>${labelEmailColon}</strong> ${opt.dataset.email}</p>`;

                fetch(`/Pedido/ObtenerDireccionesCliente?idCliente=${this.value}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById('contenedorDireccion').innerHTML = html;
                    });
            } else {
                contenedor.innerHTML = `<p class="mb-0 text-muted">${msgSeleccioneClienteInfo}</p>`;
                document.getElementById('contenedorDireccion').innerHTML = `
                    <label class="form-label">${labelDireccionEntrega}</label>
                    <select name="IdDireccion" class="form-select">
                        <option value="">${optPrimeroSeleccioneCliente}</option>
                    </select>`;
            }
        });

        document.getElementById('selectMetodoPago')?.addEventListener('change', function () {
            const opt = this.options[this.selectedIndex];
            const descripcion = opt.dataset.descripcion || '';

            const campoMonto = document.getElementById('campoMontoRecibido');
            const campoVuelto = document.getElementById('campoVuelto');
            const campoTarjeta = document.getElementById('campoTarjeta');

            campoMonto.style.display = 'none';
            campoVuelto.style.display = 'none';
            campoTarjeta.style.display = 'none';

            if (descripcion.includes('efectivo')) {
                campoMonto.style.display = 'block';
                campoVuelto.style.display = 'block';
            } else if (descripcion.includes('tarjeta')) {
                campoTarjeta.style.display = 'block';
            }
        });

        document.getElementById('inputMontoRecibido')?.addEventListener('input', actualizarVuelto);

        document.getElementById('btnAgregarLinea').addEventListener('click', function () {
            const select = document.getElementById('selectItem');
            const cantidad = document.getElementById('inputCantidadNueva').value;
            const observaciones = document.getElementById('inputObservacionesNueva').value;

            if (!select.value) {
                Swal.fire({ title: msgError, text: msgDebeSeleccionarProductoCombo, icon: "error" });
                return;
            }
            if (!cantidad || cantidad <= 0) {
                Swal.fire({ title: msgError, text: msgCantidadMayorCero, icon: "error" });
                return;
            }

            const [tipo, id] = select.value.split('-');
            const params = new URLSearchParams();
            if (tipo === 'P') params.append('idProducto', id);
            if (tipo === 'C') params.append('idCombo', id);
            params.append('cantidad', cantidad);
            params.append('observaciones', observaciones);

            fetch('/Pedido/AgregarLinea', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiforgeryToken,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
                .then(response => {
                    if (!response.ok) return response.text().then(text => { throw new Error(text) });
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenedorDetallePedido').innerHTML = html;
                    actualizarTotalInline();
                    document.getElementById('inputCantidadNueva').value = 1;
                    document.getElementById('inputObservacionesNueva').value = '';
                    select.value = '';
                    actualizarContadorGlobal();
                })
                .catch(error => {
                    Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                });
        });

        function actualizarCantidad(input) {
            const index = input.dataset.index;
            const cantidad = input.value;

            const params = new URLSearchParams();
            params.append('index', index);
            params.append('cantidad', cantidad);

            fetch('/Pedido/ActualizarCantidad', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiforgeryToken,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
                .then(response => {
                    if (!response.ok) return response.text().then(text => { throw new Error(text) });
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenedorDetallePedido').innerHTML = html;
                    actualizarTotalInline();
                    actualizarContadorGlobal();
                })
                .catch(error => {
                    Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                });
        }

        function actualizarObservaciones(input) {
            const index = input.dataset.index;
            const observaciones = input.value;

            const params = new URLSearchParams();
            params.append('index', index);
            params.append('observaciones', observaciones);

            fetch('/Pedido/ActualizarObservaciones', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiforgeryToken,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
                .then(response => {
                    if (!response.ok) return response.text().then(text => { throw new Error(text) });
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenedorDetallePedido').innerHTML = html;
                    actualizarTotalInline();
                })
                .catch(error => {
                    Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                });
        }

        function eliminarLinea(boton) {
            const index = boton.dataset.index;

            const params = new URLSearchParams();
            params.append('index', index);

            fetch('/Pedido/EliminarLinea', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiforgeryToken,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
                .then(response => {
                    if (!response.ok) return response.text().then(text => { throw new Error(text) });
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenedorDetallePedido').innerHTML = html;
                    actualizarTotalInline();
                    actualizarContadorGlobal();
                })
                .catch(error => {
                    Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                });
        }

        document.getElementById('btnGuardarDireccion')?.addEventListener('click', function () {
            const provincia = document.getElementById('nuevaProvincia').value.trim();
            const canton = document.getElementById('nuevoCanton').value.trim();
            const distrito = document.getElementById('nuevoDistrito').value.trim();
            const detalle = document.getElementById('nuevoDetalle').value.trim();

            if (!provincia || !canton || !distrito || !detalle) {
                Swal.fire({ title: msgError, text: msgCamposDireccionObligatorios, icon: "error" });
                return;
            }

            const params = new URLSearchParams();
            params.append('provincia', provincia);
            params.append('canton', canton);
            params.append('distrito', distrito);
            params.append('detalle', detalle);

            fetch('/Pedido/CrearDireccion', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiforgeryToken,
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: params
            })
                .then(response => {
                    if (!response.ok) return response.text().then(text => { throw new Error(text) });
                    return response.text();
                })
                .then(html => {
                    document.getElementById('contenedorDireccion').innerHTML = html;
                })
                .catch(error => {
                    Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                });
        });

        document.addEventListener('click', function (e) {
            if (e.target.id === 'btnGuardarDireccionCliente') {
                const provincia = document.getElementById('nuevaProvinciaCliente').value.trim();
                const canton = document.getElementById('nuevoCantonCliente').value.trim();
                const distrito = document.getElementById('nuevoDistritoCliente').value.trim();
                const detalle = document.getElementById('nuevoDetalleCliente').value.trim();
                const idCliente = document.getElementById('idClienteParaDireccion').value;

                if (!provincia || !canton || !distrito || !detalle) {
                    Swal.fire({ title: msgError, text: msgCamposDireccionObligatorios, icon: "error" });
                    return;
                }

                const params = new URLSearchParams();
                params.append('provincia', provincia);
                params.append('canton', canton);
                params.append('distrito', distrito);
                params.append('detalle', detalle);
                params.append('idCliente', idCliente);

                fetch('/Pedido/CrearDireccion', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': antiforgeryToken,
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: params
                })
                    .then(response => {
                        if (!response.ok) return response.text().then(text => { throw new Error(text) });
                        return response.text();
                    })
                    .then(html => {
                        document.getElementById('contenedorDireccion').innerHTML = html;
                    })
                    .catch(error => {
                        Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                    });
            }
        });

        document.getElementById('btnAbrirModalPago').addEventListener('click', function () {
            const filas = document.querySelectorAll('.carrito-table tbody tr td.text-end');
            if (filas.length === 0) {
                Swal.fire({ title: msgError, text: msgDebeAgregarProductoComboPedido, icon: "error" });
                document.getElementById('seccionDetalle').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            const tipoEntrega = document.getElementById('selectTipoEntrega').value;
            if (!tipoEntrega) {
                Swal.fire({ title: msgError, text: msgDebeSeleccionarMetodoEntrega, icon: "error" });
                return;
            }

            actualizarResumenModal();
            modalPago.show();
        });

        document.getElementById('btnConfirmarPago').addEventListener('click', function () {
            const metodoPago = document.getElementById('selectMetodoPago');
            if (!metodoPago.value) {
                Swal.fire({ title: msgError, text: msgDebeSeleccionarMetodoPago, icon: "error" });
                return;
            }

            const descripcion = metodoPago.options[metodoPago.selectedIndex].dataset.descripcion || '';
            const total = parseFloat(document.getElementById('modalValorTotal').dataset.totalCrudo) || 0;

            if (descripcion.includes('efectivo')) {
                const monto = parseFloat(document.getElementById('inputMontoRecibido').value) || 0;
                if (monto < total) {
                    Swal.fire({ title: msgError, text: msgMontoRecibidoInsuficiente, icon: "error" });
                    return;
                }
            } else if (descripcion.includes('tarjeta')) {
                const ultimos4 = document.getElementById('inputUltimos4').value.trim();
                if (ultimos4.length !== 4) {
                    Swal.fire({ title: msgError, text: msgDebeIndicarUltimos4, icon: "error" });
                    return;
                }
            }

            const boton = this;
            boton.disabled = true;

            const formData = new FormData(document.getElementById('formPedido'));

            fetch('/Pedido/Create', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': antiforgeryToken
                },
                body: formData
            })
                .then(response => {
                    if (!response.ok) return response.text().then(text => { throw new Error(text) });
                    return response.json();
                })
                .then(data => {
                    modalPago.hide();
                    Swal.fire({
                        icon: "success",
                        title: msgPedidoRegistrado,
                        showConfirmButton: false,
                        timer: 1500
                    }).then(() => {
                        window.location.href = data.redirectUrl;
                    });
                })
                .catch(error => {
                    boton.disabled = false;
                    Swal.fire({ title: msgErrorGenerico, text: error.message, icon: "error" });
                });
        });

    </script>
}