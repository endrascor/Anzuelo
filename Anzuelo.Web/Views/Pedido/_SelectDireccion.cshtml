@model Anzuelo.Application.DTOs.DireccionDTO

<div class="row mt-3" id="seccionDireccion" style="display:none;">
    <div class="col-md-12">
        <label class="form-label">Dirección de entrega</label>
        <select asp-for="IdDireccion" name="IdDireccion" class="form-select">
            <option value="@Model.IdDireccion" selected>@Model.Provincia, @Model.Canton, @Model.Distrito - @Model.Detalle</option>
        </select>
        <div class="form-text text-success mt-1">
            <i class="bi bi-check-circle me-1"></i>Dirección registrada correctamente.
        </div>
    </div>
</div>