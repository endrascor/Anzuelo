@using System.Security.Claims

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Anzuelo
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Anzuelo.Web.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />


    <style>

        .btn-acceso {
            display: flex;
            align-items: center;
            gap: .65rem;
            background-color: var(--anzuelo-accent);
            color: #fff !important;
            border: 2px solid var(--anzuelo-accent);
            border-radius: .65rem;
            padding: .45rem .9rem !important;
            text-decoration: none;
            transition: .2s;
            min-width: 155px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, .12);
        }

            .btn-acceso:hover {
                background-color: #fff;
                color: var(--anzuelo-primary) !important;
                border-color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 5px 14px rgba(0, 0, 0, .18);
            }

        .btn-acceso-icon {
            font-size: 1.6rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-acceso-texto {
            display: flex;
            flex-direction: column;
            text-align: left;
            line-height: 1.1;
            max-width: 190px;
        }

        .btn-acceso-titulo {
            font-size: .95rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .btn-acceso-subtitulo {
            font-size: .72rem;
            opacity: .9;
            margin-top: .15rem;
        }

        .btn-acceso.dropdown-toggle::after {
            margin-left: auto;
        }

        .btn-acceso.dropdown-toggle {
            cursor: pointer;
        }

        .dropdown-usuario {
            min-width: 220px;
            border: none;
            border-radius: .65rem;
            overflow: hidden;
        }


            .dropdown-usuario .dropdown-header {
                color: var(--anzuelo-primary);
                font-weight: 700;
            }


            .dropdown-usuario .dropdown-item {
                padding: .65rem 1rem;
            }


                .dropdown-usuario .dropdown-item:hover {
                    background-color: #f8f9fa;
                }

        @@media (max-width: 991px) {

            .btn-acceso {
                margin-top: .8rem;
                width: 100%;
                justify-content: center;
            }


            .btn-acceso-texto {
                max-width: none;
            }
        }

    </style>

</head>


<body style="min-height:100vh; display:flex; flex-direction:column;">

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm"
             style="background-color: var(--anzuelo-primary);">


            <div class="container">

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">


                    <div class="logo-circle me-3">

                        <img src="~/images/logo.png"
                             alt="Logo"
                             class="logo-img" />

                    </div>


                    <span style="font-size:2rem;font-weight:bold;">

                        ANZUELO

                    </span>

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarAnzuelo"
                        aria-controls="navbarAnzuelo"
                        aria-expanded="false"
                        aria-label="Abrir navegación">


                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse justify-content-end"
                     id="navbarAnzuelo">


                    <ul class="navbar-nav text-end align-items-lg-center">

                        <li class="nav-item mx-3">

                            <a class="nav-link text-white fs-5"
                               asp-controller="Home"
                               asp-action="Index">

                                Inicio

                            </a>

                        </li>

                        <li class="nav-item mx-3">

                            <a class="nav-link text-white fs-5"
                               asp-controller="Menu"
                               asp-action="Index">

                                Menu

                            </a>

                        </li>

                        <li class="nav-item mx-3">

                            <a class="nav-link text-white fs-5"
                               asp-controller="Combo"
                               asp-action="Index">

                                Combos

                            </a>

                        </li>

                        <li class="nav-item mx-3">

                            <a class="nav-link text-white fs-5"
                               asp-controller="Producto"
                               asp-action="Index">

                                Productos

                            </a>

                        </li>

                        <li class="nav-item mx-3">

                            <a class="nav-link text-white fs-5"
                               asp-controller="Preparacion"
                               asp-action="Index">

                                Preparación

                            </a>

                        </li>

                        <li class="nav-item dropdown mx-3">


                            <a class="nav-link dropdown-toggle text-white fs-5"
                               href="#"
                               id="navbarDropdownAdmin"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-expanded="false">

                                Administración

                            </a>


                            <ul class="dropdown-menu dropdown-menu-end"
                                aria-labelledby="navbarDropdownAdmin">

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Usuario"
                                       asp-action="Index">

                                        Usuarios

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Combo"
                                       asp-action="IndexAdmin">

                                        Combos Admin

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Producto"
                                       asp-action="IndexAdmin">

                                        Productos Admin

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Preparacion"
                                       asp-action="IndexAdmin">

                                        Preparación Admin

                                    </a>

                                </li>

                                <li>

                                    <a class="dropdown-item"
                                       asp-controller="Menu"
                                       asp-action="IndexAdmin">

                                        Menu Admin

                                    </a>

                                </li>


                            </ul>

                        </li>

                        @if (User.Identity != null &&
                                                User.Identity.IsAuthenticated)
                        {

                            var idUsuario =
                            User.FindFirst(
                            ClaimTypes.NameIdentifier
                            )?.Value;

                            <li class="nav-item dropdown ms-lg-3 d-flex align-items-center">

                                <a class="btn-acceso dropdown-toggle"
                                   href="#"
                                   id="navbarDropdownUsuario"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <span class="btn-acceso-icon">

                                        <i class="bi bi-person-circle"></i>

                                    </span>

                                    <span class="btn-acceso-texto">


                                        <span class="btn-acceso-titulo">

                                            @User.Identity.Name

                                        </span>


                                        <span class="btn-acceso-subtitulo">

                                            Mi cuenta

                                        </span>


                                    </span>


                                </a>

                                <ul class="dropdown-menu dropdown-menu-end shadow dropdown-usuario"
                                    aria-labelledby="navbarDropdownUsuario">

                                    <li>

                                        <h6 class="dropdown-header">

                                            <i class="bi bi-person-check me-1"></i>

                                            Mi cuenta

                                        </h6>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Usuario"
                                           asp-action="Details"
                                           asp-route-id="@idUsuario">


                                            <i class="bi bi-person-vcard me-2"></i>

                                            Detalle de usuario

                                        </a>

                                    </li>

                                    <li>

                                        <hr class="dropdown-divider" />

                                    </li>

                                    <li>

                                        <a class="dropdown-item text-danger"
                                           asp-controller="Login"
                                           asp-action="LogOff">


                                            <i class="bi bi-box-arrow-right me-2"></i>

                                            Cerrar sesión

                                        </a>

                                    </li>


                                </ul>


                            </li>

                        }
                        else
                        {

                            <li class="nav-item ms-lg-3 d-flex align-items-center">


                                <a class="btn-acceso"
                                   asp-controller="Login"
                                   asp-action="Index">

                                    <span class="btn-acceso-icon">

                                        <i class="bi bi-person-circle"></i>

                                    </span>

                                    <span class="btn-acceso-texto">

                                        <span class="btn-acceso-titulo">

                                            Iniciar Sesión/Registrarse

                                        </span>

                                    </span>

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container"
         style="flex:1;">


        <main role="main"
              class="pb-3">


            @RenderBody()


        </main>


    </div>

    <footer class="mt-5 py-4 text-center text-white"
            style="background-color: var(--anzuelo-primary);">


        <div class="container">


            <h5>

                Soda Anzuelo

            </h5>


            <p>

                Especialistas en ceviches, mariscos frescos
                y comida tradicional costarricense.

            </p>


            <p>

                📍 Puntarenas, Costa Rica

            </p>


            <p>

                📞 2222-2222

            </p>


            <p>

                ✉ contacto@anzuelo.com

            </p>


            <hr />


            <small>

                © 2026 Sistema El Anzuelo.

                Creado por:

                Dilan Sanchez y Adrian Rojas.

                Todos los derechos reservados.

            </small>


        </div>


    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @if (ViewBag.NotificationMessage != null)
    {

        <script>

            (function () {

                const msg =
                    `@Html.Raw(ViewBag.NotificationMessage)`;

                const lastMsg =
                    sessionStorage.getItem(
                        'lastNotification'
                    );


                if (lastMsg !== msg) {

                    @Html.Raw(ViewBag.NotificationMessage)

                    sessionStorage.setItem(
                        'lastNotification',
                        msg
                    );

                }

            })();

        </script>

    }


    @await RenderSectionAsync(
    "Scripts",
        required: false
        )


</body>

</html>