@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model Anzuelo.Application.DTOs.PreparacionDTO
@{
    ViewData["Title"] = Localizer["TituloCrearPreparacion"];
}

<style>
    .create-card {
        border: none;
        border-radius: .75rem;
        box-shadow: 0 4px 18px rgba(10,47,90,.10);
        overflow: hidden;
    }

    .create-card-header {
        background: var(--anzuelo-primary);
        color: #fff;
        padding: 1.25rem 1.5rem;
    }

        .create-card-header h2 {
            margin: 0;
            font-weight: 700;
        }

    .form-section {
        border: 1px solid #dee2e6;
        border-radius: .65rem;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
        background: #fff;
    }

    .form-section-title {
        color: var(--anzuelo-primary);
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }

    .estacion-fila {
        background: #f8f9fa;
        border: 1px solid #e5e8eb;
        border-radius: .55rem;
        padding: 1rem;
        margin-bottom: 1rem;
        transition: box-shadow .15s;
    }

    .btn-guardar-preparacion {
        background: var(--anzuelo-accent);
        border-color: var(--anzuelo-accent);
        color: #fff;
        font-weight: 600;
    }

        .btn-guardar-preparacion:hover {
            background: var(--anzuelo-primary);
            border-color: var(--anzuelo-primary);
            color: #fff;
        }

    .mensaje-validacion-seccion {
        font-weight: 600;
        margin-top: .65rem;
    }

    .orden-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: var(--anzuelo-primary);
        color: #fff;
        border-radius: 50%;
        font-weight: 700;
        font-size: .85rem;
    }

    .orden-controles {
        display: flex;
        flex-direction: column;
        gap: .25rem;
        margin-top: .4rem;
    }

    .btn-orden {
        width: 28px;
        height: 24px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dee2e6;
        background: #fff;
        border-radius: .3rem;
        color: var(--anzuelo-primary);
        transition: background .15s, color .15s;
    }

        .btn-orden:hover:not(:disabled) {
            background: var(--anzuelo-primary);
            color: #fff;
        }

        .btn-orden:disabled {
            opacity: .3;
            cursor: not-allowed;
        }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <div class="card create-card">
                <div class="create-card-header">
                    <h2><i class="bi bi-diagram-3 me-2"></i>@Localizer["TituloCrearPreparacion"]</h2>
                    <p class="mb-0 mt-1">@Localizer["SubtituloCrearPreparacion"]</p>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="formPreparacion">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <section class="form-section">
                            <div class="form-section-title"><i class="bi bi-info-circle me-1"></i>@Localizer["SeccionInformacionGeneral"]</div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="IdProducto" class="form-label">@Localizer["LabelProducto"]</label>
                                    <select asp-for="IdProducto" class="form-select" asp-items="@(new SelectList(ViewBag.ListProductos, "IdProducto", "Nombre"))">
                                        <option value="">@Localizer["OpcionSeleccioneProducto"]</option>
                                    </select>
                                    <span asp-validation-for="IdProducto" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Descripcion" class="form-label"></label>
                                    <input asp-for="Descripcion" class="form-control" placeholder="@Localizer["PlaceholderDescripcion"]" />
                                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                                </div>
                            </div>
                        </section>

                        <section class="form-section" id="seccionEstaciones">
                            <div class="form-section-title"><i class="bi bi-list-ol me-1"></i>@Localizer["SeccionEstacionesProceso"]</div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <p class="text-muted mb-0">@Localizer["SubtituloEstaciones"]</p>
                                <button type="button" id="btnAgregarEstacion" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-plus-lg me-1"></i>@Localizer["BtnAgregarEstacion"]
                                </button>
                            </div>

                            <div id="contenedorEstaciones">
                                @if (Model.Estaciones != null)
                                {
                                    foreach (var e in Model.Estaciones.OrderBy(x => x.NumeroOrden))
                                    {
                                        <div class="row align-items-center estacion-fila">
                                            <div class="col-md-1 mb-2 text-center">
                                                <label class="form-label d-block">&nbsp;</label>
                                                <span class="orden-badge orden-label">@e.NumeroOrden</span>
                                                <div class="orden-controles">
                                                    <button type="button" class="btn-orden btn-subir" title="@Localizer["TitleSubir"]">
                                                        <i class="bi bi-caret-up-fill"></i>
                                                    </button>
                                                    <button type="button" class="btn-orden btn-bajar" title="@Localizer["TitleBajar"]">
                                                        <i class="bi bi-caret-down-fill"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-md-5 mb-2">
                                                <label class="form-label">@Localizer["LabelEstacion"]</label>
                                                <select class="form-select estacion-select">
                                                    @foreach (var opt in ViewBag.ListEstaciones)
                                                    {
                                                        <option value="@opt.IdEstacionCocina" selected="@(opt.IdEstacionCocina == e.IdEstacionCocina)">@opt.Descripcion</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <label class="form-label">@Localizer["LabelTiempoMin"]</label>
                                                <input type="number" class="form-control tiempo-input" min="1" value="@e.TiempoEstimadoMinutos" />
                                            </div>
                                            <div class="col-md-3 mb-2">
                                                <button type="button" class="btn btn-outline-danger w-100 btn-quitar">
                                                    <i class="bi bi-trash me-1"></i>@Localizer["BtnQuitar"]
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div id="mensajeSinEstaciones" class="alert alert-light border mb-0">@Localizer["MsgSinEstaciones"]</div>
                            <div id="errorEstacionesCliente" class="text-danger mensaje-validacion-seccion"></div>
                            @if (ViewData.ModelState["EstacionesMinimo"] != null)
                            {
                                <div class="text-danger mensaje-validacion-seccion">
                                    @ViewData.ModelState["EstacionesMinimo"].Errors.First().ErrorMessage
                                </div>
                            }
                            @if (ViewData.ModelState["EstacionesDuplicadas"] != null)
                            {
                                <div class="text-danger mensaje-validacion-seccion">
                                    @ViewData.ModelState["EstacionesDuplicadas"].Errors.First().ErrorMessage
                                </div>
                            }
                            <div id="estacionesHidden"></div>
                        </section>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="IndexAdmin" class="btn btn-secondary"><i class="bi bi-arrow-left me-1"></i>@Localizer["BtnCancelar"]</a>
                            <button type="submit" class="btn btn-guardar-preparacion"><i class="bi bi-floppy me-1"></i>@Localizer["BtnGuardarProceso"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="plantillaEstacion">
    <div class="row align-items-center estacion-fila">
        <div class="col-md-1 mb-2 text-center">
            <label class="form-label d-block">&nbsp;</label>
            <span class="orden-badge orden-label"></span>
            <div class="orden-controles">
                <button type="button" class="btn-orden btn-subir" title="@Localizer["TitleSubir"]">
                    <i class="bi bi-caret-up-fill"></i>
                </button>
                <button type="button" class="btn-orden btn-bajar" title="@Localizer["TitleBajar"]">
                    <i class="bi bi-caret-down-fill"></i>
                </button>
            </div>
        </div>
        <div class="col-md-5 mb-2">
            <label class="form-label">@Localizer["LabelEstacion"]</label>
            <select class="form-select estacion-select">
                @foreach (var opt in ViewBag.ListEstaciones)
                {
                    <option value="@opt.IdEstacionCocina">@opt.Descripcion</option>
                }
            </select>
        </div>
        <div class="col-md-3 mb-2">
            <label class="form-label">@Localizer["LabelTiempoMin"]</label>
            <input type="number" class="form-control tiempo-input" min="1" value="5" />
        </div>
        <div class="col-md-3 mb-2">
            <button type="button" class="btn btn-outline-danger w-100 btn-quitar">
                <i class="bi bi-trash me-1"></i>@Localizer["BtnQuitar"]
            </button>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const msgMinEstaciones = '@Localizer["MsgMinimoEstacionesJs"]';

        const contenedorEstaciones = document.getElementById('contenedorEstaciones');
        const plantillaEstacion = document.getElementById('plantillaEstacion');
        const mensajeSinEstaciones = document.getElementById('mensajeSinEstaciones');
        const errorEstacionesCliente = document.getElementById('errorEstacionesCliente');

        function obtenerFilasEstaciones() {
            return Array.from(contenedorEstaciones.querySelectorAll('.estacion-fila'));
        }

        function renumerar() {
            const filas = obtenerFilasEstaciones();
            filas.forEach((fila, i) => {
                fila.querySelector('.orden-label').textContent = i + 1;
                fila.querySelector('.btn-subir').disabled = (i === 0);
                fila.querySelector('.btn-bajar').disabled = (i === filas.length - 1);
            });
        }

        function actualizarMensajeEstaciones() {
            mensajeSinEstaciones.style.display = obtenerFilasEstaciones().length === 0 ? 'block' : 'none';
        }

        document.getElementById('btnAgregarEstacion').addEventListener('click', function () {
            contenedorEstaciones.insertAdjacentHTML('beforeend', plantillaEstacion.innerHTML);
            renumerar();
            errorEstacionesCliente.textContent = '';
            actualizarMensajeEstaciones();
        });

        contenedorEstaciones.addEventListener('click', function (e) {
            const btnQuitar = e.target.closest('.btn-quitar');
            if (btnQuitar) {
                btnQuitar.closest('.estacion-fila').remove();
                renumerar();
                actualizarMensajeEstaciones();
                return;
            }

            const btnSubir = e.target.closest('.btn-subir');
            if (btnSubir) {
                const fila = btnSubir.closest('.estacion-fila');
                const anterior = fila.previousElementSibling;
                if (anterior) {
                    contenedorEstaciones.insertBefore(fila, anterior);
                    renumerar();
                }
                return;
            }

            const btnBajar = e.target.closest('.btn-bajar');
            if (btnBajar) {
                const fila = btnBajar.closest('.estacion-fila');
                const siguiente = fila.nextElementSibling;
                if (siguiente) {
                    contenedorEstaciones.insertBefore(siguiente, fila);
                    renumerar();
                }
                return;
            }
        });

        document.getElementById('formPreparacion').addEventListener('submit', function (e) {
            const filas = obtenerFilasEstaciones();
            if (filas.length === 0) {
                e.preventDefault();
                errorEstacionesCliente.textContent = msgMinEstaciones;
                document.getElementById('seccionEstaciones').scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }
            errorEstacionesCliente.textContent = '';

            const contenedor = document.getElementById('estacionesHidden');
            contenedor.innerHTML = '';
            filas.forEach(fila => {
                const idEstacion = fila.querySelector('.estacion-select').value;
                const tiempo = fila.querySelector('.tiempo-input').value;
                contenedor.innerHTML += `
                    <input type="hidden" name="selectedEstaciones" value="${idEstacion}" />
                    <input type="hidden" name="selectedTiempos" value="${tiempo}" />`;
            });
        });

        renumerar();
        actualizarMensajeEstaciones();
    </script>
}