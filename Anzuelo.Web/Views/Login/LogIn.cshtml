@model Anzuelo.Web.ViewModels.ViewModelLogin

@{
    ViewData["Title"] = "Iniciar sesión";
}

<style>
    .login-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 4rem 1rem;
    }

    .login-card {
        width: 100%;
        max-width: 460px;
        background: #fffdf8;
        border-radius: .9rem;
        box-shadow: 0 6px 22px rgba(10, 47, 90, .12);
        overflow: hidden;
    }

    .login-header {
        background: linear-gradient( 135deg, var(--anzuelo-primary), #184f8a );
        color: #fff;
        padding: 1.8rem;
        text-align: center;
    }

    .login-icon {
        font-size: 2.8rem;
        margin-bottom: .5rem;
    }

    .login-title {
        font-size: 2rem;
        font-weight: 800;
        margin: 0;
    }

    .login-subtitle {
        margin-top: .4rem;
        margin-bottom: 0;
        opacity: .9;
        font-size: .95rem;
    }

    .login-body {
        padding: 2rem;
    }

    .login-label {
        color: #555;
        font-size: .8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: .4rem;
    }

    .login-input-group {
        position: relative;
    }

    .login-input-icon {
        position: absolute;
        top: 50%;
        left: 1rem;
        transform: translateY(-50%);
        color: var(--anzuelo-primary);
        z-index: 5;
    }

    .login-input {
        height: 48px;
        padding-left: 2.7rem;
        border: 1px solid #dce1e5;
        border-radius: .45rem;
        background: #fff;
    }

        .login-input:focus {
            border-color: var(--anzuelo-accent);
            box-shadow: 0 0 0 .2rem rgba(230, 126, 34, .15);
        }

    .forgot-password {
        background: transparent;
        border: none;
        color: var(--anzuelo-accent);
        font-size: .85rem;
        font-weight: 600;
        padding: 0;
        text-decoration: underline;
    }

        .forgot-password:hover {
            color: var(--anzuelo-primary);
        }

    .login-buttons {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .8rem;
        margin-top: 1.8rem;
    }

    .btn-cancel-login {
        background: transparent;
        border: 2px solid #6c757d;
        color: #6c757d;
        font-weight: 700;
        border-radius: .4rem;
        padding: .65rem 1rem;
        transition: .2s;
    }

        .btn-cancel-login:hover {
            background: #6c757d;
            color: #fff;
        }

    .btn-submit-login {
        background: var(--anzuelo-accent);
        border: 2px solid var(--anzuelo-accent);
        color: #fff;
        font-weight: 700;
        border-radius: .4rem;
        padding: .65rem 1rem;
        transition: .2s;
    }

        .btn-submit-login:hover {
            background: var(--anzuelo-primary);
            border-color: var(--anzuelo-primary);
            color: #fff;
        }

    .login-error {
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
        border-radius: .4rem;
        padding: .8rem;
        margin-bottom: 1rem;
        font-size: .9rem;
    }

    @@media (max-width: 576px) {
        .login-buttons {
            grid-template-columns: 1fr;
        }

        .login-body {
            padding: 1.5rem;
        }
    }
</style>

<div class="login-container">

    <div class="login-card">

        <div class="login-header">

            <div class="login-icon">
                <i class="bi bi-person-circle"></i>
            </div>

            <h1 class="login-title">
                Iniciar sesión
            </h1>

            <p class="login-subtitle">
                Ingrese sus credenciales para acceder al sistema
            </p>

        </div>

        <div class="login-body">

            <form asp-controller="Login"
                  asp-action="LogIn"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="login-error">
                </div>

                @if (ViewBag.Message != null)
                {
                    <div class="login-error">
                        <i class="bi bi-exclamation-circle me-1"></i>
                        @ViewBag.Message
                    </div>
                }

                <div class="mb-3">

                    <label asp-for="User"
                           class="form-label login-label">
                        Correo electrónico
                    </label>

                    <div class="login-input-group">

                        <i class="bi bi-envelope-fill login-input-icon"></i>

                        <input asp-for="User"
                               type="email"
                               class="form-control login-input"
                               placeholder="ejemplo@correo.com"
                               autocomplete="username" />

                    </div>

                    <span asp-validation-for="User"
                          class="text-danger small">
                    </span>

                </div>

                <div class="mb-2">

                    <label asp-for="Password"
                           class="form-label login-label">
                        Contraseña
                    </label>

                    <div class="login-input-group">

                        <i class="bi bi-lock-fill login-input-icon"></i>

                        <input asp-for="Password"
                               type="password"
                               class="form-control login-input"
                               placeholder="Digite su contraseña"
                               autocomplete="current-password" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger small">
                    </span>

                </div>

                <div class="text-end mt-2">

                    <button type="button"
                            class="forgot-password">
                        ¿No recuerda la contraseña?
                    </button>

                </div>

                <div class="login-buttons">

                    <a asp-controller="Login"
                       asp-action="Index"
                       class="btn-cancel-login text-center text-decoration-none">

                        <i class="bi bi-arrow-left me-1"></i>
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn-submit-login">

                        <i class="bi bi-box-arrow-in-right me-1"></i>
                        Ingresar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}