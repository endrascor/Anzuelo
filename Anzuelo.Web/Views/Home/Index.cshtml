@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["TituloPagina"];
}

<section class="text-center py-5">
    <h1 class="display-2 fw-bold" style="color:var(--anzuelo-primary);">
        EL ANZUELO
    </h1>
    <p class="lead">
        @Localizer["Eslogan"]
    </p>
</section>

<section class="text-center mb-5">
    <img src="~/images/logo.png"
         class="img-fluid"
         style="max-height:500px;"
         alt="Anzuelo" />
</section>

<section class="container mb-5">
    <div class="card shadow-sm">
        <div class="card-header bg-white text-center">
            <button class="btn btn-link text-decoration-none fs-4 fw-bold"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#quienesSomos"
                    aria-expanded="true"
                    aria-controls="quienesSomos">
                @Localizer["TituloQuienesSomos"]
            </button>
        </div>

        <div class="collapse show" id="quienesSomos">
            <div class="card-body p-5">
                <p class="fs-5 text-center">
                    @Localizer["TextoQuienesSomos1"]
                </p>
                <p class="fs-5 text-center">
                    @Localizer["TextoQuienesSomos2"]
                </p>
            </div>
        </div>
    </div>
</section>